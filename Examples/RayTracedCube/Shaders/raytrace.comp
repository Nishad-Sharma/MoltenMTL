#version 460
#extension GL_EXT_ray_query : require

layout(local_size_x = 8, local_size_y = 8) in;

// Binding layout (reflected from SPIR-V):
//   binding 0 — pixel buffer (IMAGE_SIZE * IMAGE_SIZE * 4 floats, RGBA row-major)
//   binding 1 — TLAS
//   binding 2 — scene uniforms (camera + light)
//   binding 3 — per-instance materials (indexed by gl_InstanceID)
//   binding 4 — cube texture (storage image; sampled with imageLoad, nearest)
//   binding 5 — cube triangle indices (uint[])
//   binding 6 — cube per-vertex UVs (vec2[])
//   binding 7 — cube per-vertex normals (vec4[], xyz)
layout(set = 0, binding = 0) buffer PixelBuffer { float pixels[]; };
layout(set = 0, binding = 1) uniform accelerationStructureEXT tlas;
layout(set = 0, binding = 4, rgba8) uniform readonly image2D cubeTex;
layout(set = 0, binding = 5) readonly buffer CubeIndices { uint cubeIndices[]; };
layout(set = 0, binding = 6) readonly buffer CubeUVs     { vec2 cubeUVs[]; };
layout(set = 0, binding = 7) readonly buffer CubeNormals { vec4 cubeNormals[]; };

layout(set = 0, binding = 2) readonly buffer Uniforms {
    vec4 eyeTanHalfFov;      // xyz = eye,     w = tan(fovY/2)
    vec4 forwardAspect;      // xyz = forward, w = aspect
    vec4 camRight;           // xyz = right
    vec4 camUp;              // xyz = up
    vec4 lightPosIntensity;  // xyz = light pos,   w = intensity
    vec4 lightColorAmbient;  // xyz = light color, w = ambient
} U;

struct Material {
    vec4 albedo;
    vec4 props;  // x = mode (0 solid, 1 textured), y = shininess, z = specStrength
};
layout(set = 0, binding = 3) readonly buffer Materials { Material materials[]; };

const int IMAGE_SIZE = 256;


void main() {
    uvec2 id  = gl_GlobalInvocationID.xy;
    uint  idx = (id.y * uint(IMAGE_SIZE) + id.x) * 4u;

    vec3  eye        = U.eyeTanHalfFov.xyz;
    vec3  forward    = U.forwardAspect.xyz;
    vec3  right      = U.camRight.xyz;
    vec3  up         = U.camUp.xyz;
    float tanHalfFov = U.eyeTanHalfFov.w;
    float aspect     = U.forwardAspect.w;

    // UV in [-1, 1]; flip V so +Y is up in the output image.
    float u = ((float(id.x) + 0.5) / float(IMAGE_SIZE) * 2.0 - 1.0) * aspect;
    float v = 1.0 - (float(id.y) + 0.5) / float(IMAGE_SIZE) * 2.0;
    vec3  dir = normalize(forward + u * tanHalfFov * right + v * tanHalfFov * up);

    rayQueryEXT rq;
    rayQueryInitializeEXT(rq, tlas, gl_RayFlagsOpaqueEXT,
                          0xFF,    // cull mask — test all instances
                          eye, 0.001, dir, 100.0);
    while (rayQueryProceedEXT(rq)) {}

    vec3 color = vec3(0.0);  // black background for misses
    if (rayQueryGetIntersectionTypeEXT(rq, true) !=
            gl_RayQueryCommittedIntersectionNoneEXT) {

        uint  instId = rayQueryGetIntersectionInstanceIdEXT(rq, true);
        float t      = rayQueryGetIntersectionTEXT(rq, true);
        vec3  P      = eye + t * dir;
        uint  prim   = uint(rayQueryGetIntersectionPrimitiveIndexEXT(rq, true));

        Material m         = materials[instId];
        float    shininess = m.props.y;
        float    specStr   = m.props.z;

        // Cube (instance 0) carries per-vertex attributes — interpolate its normal (and
        // UV for the texture) across the hit triangle via barycentrics. The plane
        // (instance 1) is a flat quad with a constant +Y normal.
        vec3 N;
        vec3 albedo;
        if (instId == 0u) {
            uint  i0 = cubeIndices[prim * 3u + 0u];
            uint  i1 = cubeIndices[prim * 3u + 1u];
            uint  i2 = cubeIndices[prim * 3u + 2u];
            vec2  b  = rayQueryGetIntersectionBarycentricsEXT(rq, true);  // weights for v1, v2
            float w0 = 1.0 - b.x - b.y;

            N = normalize(w0 * cubeNormals[i0].xyz + b.x * cubeNormals[i1].xyz + b.y * cubeNormals[i2].xyz);

            // Textured: read the texture (nearest — MoltenMTL has no samplers yet).
            vec2  uv = w0 * cubeUVs[i0] + b.x * cubeUVs[i1] + b.y * cubeUVs[i2];
            ivec2 ts = imageSize(cubeTex);
            ivec2 tx = clamp(ivec2(uv * vec2(ts)), ivec2(0), ts - 1);
            albedo = imageLoad(cubeTex, tx).rgb;
        } else {
            N = vec3(0.0, 1.0, 0.0);
            albedo = m.albedo.xyz;
        }

        // Point-light shading (Blinn-Phong). Same math a fragment shader would use.
        vec3  lightPos   = U.lightPosIntensity.xyz;
        float intensity  = U.lightPosIntensity.w;
        vec3  lightColor = U.lightColorAmbient.xyz;
        float ambient    = U.lightColorAmbient.w;

        vec3  toLight = lightPos - P;
        float dist2   = max(dot(toLight, toLight), 1e-4);
        vec3  L       = toLight * inversesqrt(dist2);
        vec3  V       = normalize(eye - P);
        vec3  H       = normalize(L + V);

        float atten = intensity / dist2;
        float diff  = max(dot(N, L), 0.0);
        float spec  = (diff > 0.0) ? pow(max(dot(N, H), 0.0), shininess) * specStr : 0.0;

        color = albedo * ambient
              + (albedo * diff + vec3(spec)) * atten * lightColor;
    }

    pixels[idx]      = color.r;
    pixels[idx + 1u] = color.g;
    pixels[idx + 2u] = color.b;
    pixels[idx + 3u] = 1.0;
}
