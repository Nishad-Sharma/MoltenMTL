#version 460
#extension GL_EXT_ray_query : require

layout(local_size_x = 8, local_size_y = 8) in;

// Binding layout:
//   0 — pixel buffer
//   1 — TLAS
//   2 — camera
//   3 — light
//   4 — per-instance materials
//   5 — per-instance mesh indices
//   6 — per-mesh vertex ranges (indexStart, vertexStart)
//   7 — all mesh indices packed
//   8 — all mesh UVs packed
//   9 — all mesh normals packed
//  10 — texture array (storage images, nearest via imageLoad)

layout(set = 0, binding = 0) buffer PixelBuffer { float pixels[]; };
layout(set = 0, binding = 1) uniform accelerationStructureEXT tlas;

layout(set = 0, binding = 2) readonly buffer Camera {
    vec4  eye;          // xyz used, w ignored — matches Swift SIMD3<Float> (16B)
    vec4  target;
    vec4  up;
    float fovYDegrees;
    float aspect;
} cam;

layout(set = 0, binding = 3) readonly buffer Light {
    vec4  position;    // xyz used, w ignored — matches Swift SIMD3<Float> (16B)
    vec4  color;
    float intensity;
    float ambient;
} light;

struct Material {
    vec4  diffuseColor;   // xyz = colour, w ignored — matches Swift SIMD3<Float> (16B)
    int   textureIndex;   // -1 = solid, >=0 = index into scene textures
    float shininess;
    float specStrength;
    // 4B implicit padding (struct stride = 32B under std430)
};
layout(set = 0, binding = 4) readonly buffer Materials { Material materials[]; };

layout(set = 0, binding = 5) readonly buffer InstMeshIdx { uint instMeshIdx[]; };

struct MeshRange { uint indexStart; uint vertexStart; };
layout(set = 0, binding = 6) readonly buffer MeshRanges { MeshRange meshRanges[]; };

layout(set = 0, binding = 7) readonly buffer AllIndices { uint allIndices[]; };
layout(set = 0, binding = 8) readonly buffer AllUVs     { vec2 allUVs[]; };
layout(set = 0, binding = 9) readonly buffer AllNormals { vec4 allNormals[]; };

const int MAX_TEXTURES = 8;
layout(set = 0, binding = 10, rgba8) uniform readonly image2D textures[MAX_TEXTURES];

const int IMAGE_SIZE = 256;

void main() {
    uvec2 id  = gl_GlobalInvocationID.xy;
    uint  idx = (id.y * uint(IMAGE_SIZE) + id.x) * 4u;

    vec3  eye        = cam.eye.xyz;
    vec3  forward    = normalize(cam.target.xyz - eye);
    vec3  right      = normalize(cross(forward, cam.up.xyz));
    vec3  up         = cross(right, forward);
    float tanHalfFov = tan(cam.fovYDegrees * 3.14159265 / 180.0 * 0.5);
    float aspect     = cam.aspect;

    // UV in [-1, 1]; flip V so +Y is up in the output image.
    float u = ((float(id.x) + 0.5) / float(IMAGE_SIZE) * 2.0 - 1.0) * aspect;
    float v = 1.0 - (float(id.y) + 0.5) / float(IMAGE_SIZE) * 2.0;
    vec3  dir = normalize(forward + u * tanHalfFov * right + v * tanHalfFov * up);

    rayQueryEXT rq;
    rayQueryInitializeEXT(rq, tlas, gl_RayFlagsOpaqueEXT,
                          0xFF, eye, 0.001, dir, 100.0);
    while (rayQueryProceedEXT(rq)) {}

    vec3 color = vec3(0.0);  // black background for misses
    if (rayQueryGetIntersectionTypeEXT(rq, true) !=
            gl_RayQueryCommittedIntersectionNoneEXT) {

        uint  instId = rayQueryGetIntersectionInstanceIdEXT(rq, true);
        float t      = rayQueryGetIntersectionTEXT(rq, true);
        vec3  P      = eye + t * dir;
        uint  prim   = uint(rayQueryGetIntersectionPrimitiveIndexEXT(rq, true));

        Material m = materials[instId];

        // Look up this instance's mesh and its vertex data range.
        uint      mesh = instMeshIdx[instId];
        MeshRange r    = meshRanges[mesh];

        uint  i0 = allIndices[r.indexStart + prim * 3u + 0u];
        uint  i1 = allIndices[r.indexStart + prim * 3u + 1u];
        uint  i2 = allIndices[r.indexStart + prim * 3u + 2u];
        vec2  b  = rayQueryGetIntersectionBarycentricsEXT(rq, true);
        float w0 = 1.0 - b.x - b.y;

        // Always interpolate the normal from per-vertex data.
        vec3 N = normalize(
            w0 * allNormals[r.vertexStart + i0].xyz +
            b.x * allNormals[r.vertexStart + i1].xyz +
            b.y * allNormals[r.vertexStart + i2].xyz);

        vec3 albedo;
        if (m.textureIndex >= 0) {
            vec2  uv = w0 * allUVs[r.vertexStart + i0]
                     + b.x * allUVs[r.vertexStart + i1]
                     + b.y * allUVs[r.vertexStart + i2];
            ivec2 ts = imageSize(textures[m.textureIndex]);
            ivec2 tx = clamp(ivec2(uv * vec2(ts)), ivec2(0), ts - 1);
            albedo = imageLoad(textures[m.textureIndex], tx).rgb;
        } else {
            albedo = m.diffuseColor.xyz;
        }

        // Point-light shading (Blinn-Phong).
        vec3  lightPos   = light.position.xyz;
        float intensity  = light.intensity;
        vec3  lightColor = light.color.xyz;
        float ambient    = light.ambient;

        vec3  toLight = lightPos - P;
        float dist2   = max(dot(toLight, toLight), 1e-4);
        vec3  L       = toLight * inversesqrt(dist2);
        vec3  V       = normalize(eye - P);
        vec3  H       = normalize(L + V);

        float atten = intensity / dist2;
        float diff  = max(dot(N, L), 0.0);
        float spec  = (diff > 0.0) ? pow(max(dot(N, H), 0.0), m.shininess) * m.specStrength : 0.0;

        color = albedo * ambient
              + (albedo * diff + vec3(spec)) * atten * lightColor;
    }

    pixels[idx]      = color.r;
    pixels[idx + 1u] = color.g;
    pixels[idx + 2u] = color.b;
    pixels[idx + 3u] = 1.0;
}
